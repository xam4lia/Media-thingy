// Local emulation only. Production bindings are configured in the Pages dashboard.
{
  "name": "media-thingy-local",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "media-thingy-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MUSIC", "bucket_name": "media-thingy-local" }],
}
