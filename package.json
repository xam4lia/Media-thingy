{
  "name": "media-thingy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/generate-supabase.mjs --check && tsc -b && tsc -p tsconfig.server.json && vite build",
    "generate:supabase": "node scripts/generate-supabase.mjs",
    "test:supabase": "MEDIA_TEST_SUPABASE=1 vitest run server/supabase.test.ts",
    "test:supabase:e2e": "playwright test --config playwright.supabase.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src server",
    "dev:accounts": "npm run build && node scripts/dev-accounts.mjs",
    "test:accounts": "playwright test --config playwright.accounts.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build:pages": "tsc -b && vite build --base=/Media-thingy/",
    "deploy": "npm run build:pages && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.56.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.0.0",
    "gh-pages": "^6.3.0",
    "miniflare": "^5.20261019.2-beta",
    "pg": "^8.23.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
